# EarthSync Environment Configuration

# Backend API & WebSocket Port
PORT=5000

# ESP32 Hardware Serial Ingest (Set to actual COM/TTY port or leave empty for auto-mock fallback)
SERIAL_PORT=COM3
SERIAL_BAUD_RATE=115200

# VITE Frontend Environment Variables
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000/ws
VITE_ENABLE_HARDWARE=true
VITE_DEFAULT_LANGUAGE=en
